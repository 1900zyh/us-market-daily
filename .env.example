# Optional OpenAI-compatible Chat Completions endpoint.
# Copy to .env and start using: node --env-file=.env server.mjs
# You can also configure these in the website model settings dialog.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_TYPE=chat
LLM_ENABLED=false
